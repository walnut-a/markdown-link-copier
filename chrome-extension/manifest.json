{
  "manifest_version": 3,
  "name": "Markdown Link Copier",
  "description": "Cleans the current tab URL and copies it as formatted text to the clipboard.",
  "version": "1.4.0",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "description": "复制当前页面链接文本"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy Link Text",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
