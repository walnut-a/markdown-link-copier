{
  "manifest_version": 3,
  "name": "Markdown Link Copier",
  "description": "Cleans the current tab URL and copies it as a Markdown link to the clipboard.",
  "version": "1.1.1",
  "permissions": ["activeTab", "tabs", "scripting", "clipboardWrite", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy Markdown Link",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
